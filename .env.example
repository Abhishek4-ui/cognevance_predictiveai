# PredictAI Pro - Environment Variables Template
PROJECT_NAME="PredictAI Pro"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./predictai.db"
NEON_REST_URL=""

# Security
SECRET_KEY="your-secure-secret-key-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
ADMIN_EMAIL="admin@predictai.pro"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeInProd123!"

# Cloud Deployment Keys (Optional)
RENDER_API_KEY=""
VERCEL_TOKEN=""
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# Ports & Hosts
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
